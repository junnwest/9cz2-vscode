# Trajectory and restart files (large — keep on Midway3)
*.dcd
*.trr
*.xtc
*.crd
*.coor
*.vel
*.xsc
*.xst
*.restart.coor
*.restart.vel
*.restart.xsc

# Large structure files
*.psf

# NAMD output (can be large)
*.out

# CHARMM-GUI downloads
*.tgz
*.tar.gz

# Local trajectory pulls for visual inspection (large — keep on Beagle3/Midway3)
# Data is ignored, but README.md and the .tcl load/analysis scripts ARE tracked.
# Use trajectories/* (not trajectories/) so git still descends and can see the
# negations below. A negated directory (e.g. !trajectories/namd) only un-ignores
# the directory ENTRY, not its contents — each subdirectory needs its own
# re-ignore-then-allow-tcl pair, or new large data dropped in there gets committed.
trajectories/*
!trajectories/README.md
!trajectories/load_v1_v6.tcl
!trajectories/namd
trajectories/namd/*
!trajectories/namd/*.tcl
!trajectories/martini_sweep
trajectories/martini_sweep/*
!trajectories/martini_sweep/*.tcl
dome-bact_traj/
full-bact_traj/

# CHARMM-GUI / AlphaFold bulk downloads (GB-scale structural data, not source)
charmm-gui-*/
fold_hflk_m3_opt1_extended/
dome_m3_af3_ic_minimized_final*.pdb
dome_m3_af3_ic_minimized_final*.cif

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# macOS
.DS_Store

# VMD
vmdscene*
